# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=

# JWT Secrets for Authentication (Use random 32+ character strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Allowed Client URLs for CORS (Storefront & Admin Console)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudinary Storage for Truck Parts Images, Diagrams, and Spec PDFs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (SMTP / Nodemailer) for Order Confirmations & Quotes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aurex Truck Parts <sales@truckparts.com>"

# Store Information
STORE_NAME="Aurex Truck Parts"
STORE_CURRENCY="AUD"
STORE_SUPPORT_EMAIL="support@truckparts.com"
STORE_SUPPORT_PHONE="+61 2 8000 0000"

# Initial Seed Admin Credentials (used by seed scripts)
ADMIN_NAME="Aurex Admin"
ADMIN_EMAIL=admin@truckparts.com
ADMIN_PASSWORD=AdminPassword123!
