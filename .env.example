# ─────────────────────────────────────────────────────────────
# Aurex Truck Parts API — environment template
# Copy to `.env` and fill in real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB — local or MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/aurex

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS — comma-separated list of allowed storefront/admin origins
CLIENT_ORIGINS=http://localhost:5173,http://localhost:5174

# Seed admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@aurex.com.au
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Store Admin

# Cookie
COOKIE_SECURE=false

# Public storefront URL — used in emails for tracking + password-reset links
APP_URL=http://localhost:5173

# ── Transactional email (Resend) — OPTIONAL ──
# Leave blank to disable email (orders/enquiries still work; sends are logged, not sent).
# Get a key at https://resend.com and verify your sending domain (aurex.com.au).
RESEND_API_KEY=
EMAIL_FROM=Aurex Truck Parts <onboarding@resend.dev>
STORE_INBOX_EMAIL=sales@aurex.com.au

# ── Payments (Stripe) — OPTIONAL ──
# Leave blank to disable online card payments (Card orders fall back to "Pending payment").
# Keys at https://dashboard.stripe.com/apikeys ; webhook secret from your webhook endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
