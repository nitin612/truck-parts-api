# Server Configuration
PORT=5001
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=

# JWT Secrets for Authentication (Use random 32+ character strings)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Allowed Client URLs for CORS (Storefront & Admin Console)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Canonical storefront origin used in sitemap.xml <loc> entries (defaults to the live www host)
SITE_URL=https://www.aurextruckparts.com.au

# IndexNow (Bing re-crawl pings on product changes). On by default only in Vercel production.
# The key must match the /<key>.txt file served by the storefront.
# INDEXNOW_KEY=4530209e175d6a57f229efa52991edd3
# INDEXNOW_ENABLED=false

# Storefront rebuild after catalogue edits, so its build-time HTML snapshots stay current.
# Production only: the storefront's Vercel Deploy Hook URL (Storefront project > Settings > Git > Deploy Hooks).
# STOREFRONT_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
# Shared secret Vercel Cron sends to /api/v1/internal/storefront-rebuild (daily catch-up rebuild).
# CRON_SECRET=

# Google Business Profile review link, shown in delivered-order emails when set (Profile > Ask for reviews).
# GOOGLE_REVIEW_URL=https://g.page/r/xxxxxxxx/review

# Cloudinary Storage for Truck Parts Images, Diagrams, and Spec PDFs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional Email (SMTP / Nodemailer) for Order Confirmations & Quotes
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Aurex Truck Parts <sales@truckparts.com>"

# Store Information
STORE_NAME="Aurex Truck Parts"
STORE_CURRENCY="AUD"
STORE_SUPPORT_EMAIL="support@truckparts.com"
STORE_SUPPORT_PHONE="+61 2 8000 0000"

# Initial Seed Admin Credentials (used by seed scripts)
ADMIN_NAME="Aurex Admin"
ADMIN_EMAIL=admin@truckparts.com
ADMIN_PASSWORD=AdminPassword123!
