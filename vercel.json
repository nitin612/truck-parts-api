{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/internal/storefront-rebuild",
      "schedule": "0 17 * * *"
    }
  ]
}
